# Copy this file to .env and fill in your own values. Never commit .env.

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ---------------- AI (optional) ----------------
# Leave AI_API_KEY empty to run in rule-based mode (everything still works).
#
# Option A - Google Gemini (free tier key: https://aistudio.google.com/apikey)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
#
# Option B - any OpenAI-compatible API (Groq, OpenRouter, local Ollama, ...)
# AI_PROVIDER=openai
# AI_API_KEY=your-key            (Ollama: any non-empty text, e.g. ollama)
# AI_MODEL=llama-3.1-8b-instant  (Ollama example: llama3.1)
# AI_BASE_URL=https://api.groq.com/openai/v1   (Ollama: http://localhost:11434/v1)

AI_TIMEOUT=40

# ---------------- Other ----------------
MAX_UPLOAD_MB=5
# DATABASE_URL=sqlite:///absolute/path/to/career_match.db
FLASK_DEBUG=1
PORT=5000
